BOT_TOKEN=your-telegram-bot-token-from-botfather
DB_PATH=./data/fairsharebot.sqlite3
LOG_LEVEL=INFO
LOG_DIR=./logs

# Optional: only set these when deploying behind a webhook (e.g. on Replit).
# Leave both unset for local dev - the bot falls back to long-polling.
# WEBHOOK_URL=https://your-public-https-url
# PORT=8080

# Optional: only set these to enable token-mode trips (/starttriptoken).
# Leave WALLET_MASTER_MNEMONIC unset for a cash-only deployment - if it's
# unset, none of the rest below are read and token mode stays fully off.
# All of the below are required together once WALLET_MASTER_MNEMONIC is set.
#
# WALLET_MASTER_MNEMONIC derives every custodial wallet (BIP-39 mnemonic,
# keep this at least as secret as BOT_TOKEN - anyone with it controls every
# custodial wallet the bot has ever created). RELAYER_PRIVATE_KEY must be a
# wholly separate key (not derived from the mnemonic) generated once offline
# for the bot's own gas wallet.
# WALLET_MASTER_MNEMONIC=twelve or twenty-four word bip-39 phrase
# RELAYER_PRIVATE_KEY=0x...
# BASE_RPC_URL=https://sepolia.base.org
# CHAIN_ID=84532               # Base Sepolia; Base mainnet is 8453
# TOKEN_ADDRESS=0x...          # FairShareToken, from deployments/base-sepolia.json
# SETTLEMENT_ADDRESS=0x...     # Settlement, from deployments/base-sepolia.json
# OWNER_TELEGRAM_USER_ID=123456789   # only this Telegram user id may run /minttoken
# WALLET_LINK_BASE_URL=https://yourdomain.com/wallet   # the standalone
#   signing-page web app (python -m fairsharebot.webapp), reverse-proxied
#   under the same public domain as WEBHOOK_URL above but a separate process
# OWNER_PRIVATE_KEY=0x...      # optional, only needed for /minttoken - a
#   deliberately separate key from RELAYER_PRIVATE_KEY (mint vs settle are
#   different roles); must be the FairShareToken/Settlement contracts' owner
